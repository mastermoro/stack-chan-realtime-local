# Azure OpenAI / Microsoft Foundry resource endpoint
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2.1
AZURE_OPENAI_RESPONSES_DEPLOYMENT=gpt-5.6-terra

# Leave empty in Azure Container Apps to use Managed Identity.
# For local development only, an API key may be supplied.
AZURE_OPENAI_API_KEY=

# Turn detection for natural conversation. semantic_vad + low waits through
# short pauses; set type to server_vad only for deployments without semantic VAD.
REALTIME_TURN_DETECTION_TYPE=semantic_vad
REALTIME_VAD_EAGERNESS=low
# Only used with REALTIME_TURN_DETECTION_TYPE=server_vad.
REALTIME_VAD_THRESHOLD=0.5
REALTIME_VAD_PREFIX_PADDING_MS=300
REALTIME_VAD_SILENCE_DURATION_MS=1000

# JSON map: device_id -> token
DEVICE_TOKENS_JSON={"stackchan-001":"replace-me"}

# Web search location
WEB_SEARCH_COUNTRY=JP
WEB_SEARCH_TIMEZONE=Asia/Tokyo
WEB_SEARCH_CITY=
WEB_SEARCH_REGION=

# Optional comma-separated allow/deny lists
WEB_SEARCH_ALLOWED_DOMAINS=
WEB_SEARCH_BLOCKED_DOMAINS=
# Per-request Responses API timeout. Web retrieval often exceeds 20 seconds.
WEB_SEARCH_TIMEOUT_SECONDS=90

# Local Windows actions exposed to Foundry Function Calling.
# Browser opening is opt-in and never permits arbitrary command execution.
LOCAL_BROWSER_TOOL_ENABLED=false
# Optional comma-separated host allow-list. Empty permits any HTTP(S) host.
# Example: microsoft.com,github.com,localhost
LOCAL_BROWSER_ALLOWED_DOMAINS=

# Runtime
LOG_LEVEL=INFO
TRANSCRIPT_LOGGING=false
